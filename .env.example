# Notion internal integration secret.
# Create at https://www.notion.so/my-integrations, then share the tracker
# database with the integration (Notion page → ••• → Connections → your integration).
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The "KTP IIP26 — Master Tracker 2026" database.
NOTION_DATABASE_ID=7538e2f50349425ab3e2173a81c8fd41

# Optional. Skips one API call per cold cache by naming the data source directly.
# NOTION_DATA_SOURCE_ID=de2f02c0-54ab-4e2c-8079-263b09e156a8

# Optional. Seconds of cache before the dashboard re-queries Notion. Default 300.
# REVALIDATE_SECONDS=300
